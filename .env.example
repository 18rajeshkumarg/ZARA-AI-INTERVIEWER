# API/database
PORT=8787
DATABASE_URL=postgresql://user:password@localhost:5432/zara_interviews
DATABASE_SSL=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DATA_DIR=./server/data
CORS_ORIGINS=http://localhost:5173,https://18rajeshkumarg.github.io

# SMTP is required to send email verification codes
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=ZARA AI Interview <no-reply@example.com>

# Administrator account for the protected review page
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-long-unique-password

# Optional frontend override; production defaults to the Render API service
# VITE_API_URL=https://zara-ai-interviewer-api.onrender.com/api
